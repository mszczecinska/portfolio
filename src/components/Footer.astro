---
import { socialLinks } from "../lib/social";
import TablerIcon from "./TablerIcon.astro";
import { contactEmail, contactMailto } from "../lib/contact";

interface Props { workPage?: boolean; homePage?: boolean; aboutPage?: boolean; }
const { workPage = false, homePage = false, aboutPage = false } = Astro.props;

const currentYear = new Date().getFullYear();

const footerNav = [
  { label: "Główna", href: "/" },
  { label: "Realizacje", href: "/work" },
  { label: "O mnie", href: "/about" },
] as const;

const desktopDots = [
  [30, 2.5],
  [30, 5],
  [30, 7.5],
  [32.5, 5],
  [27.5, 5],
  [27.5, 27.5],
  [27.5, 30],
  [27.5, 32.5],
  [25, 30],
  [30, 30],
  [12.5, 22.5],
  [12.5, 7.5],
  [12.5, 25],
  [12.5, 10],
  [12.5, 12.5],
  [17.5, 17.5],
  [20, 17.5],
  [22.5, 17.5],
  [7.5, 17.5],
  [5, 17.5],
  [2.5, 17.5],
  [12.5, 27.5],
  [10, 20],
  [10, 15],
  [15, 15],
  [15, 20],
  [12.5, 17.5],
] as const;

const mobileDots = [
  [24, 2],
  [24, 4],
  [24, 6],
  [26, 4],
  [22, 4],
  [22, 22],
  [22, 24],
  [22, 26],
  [20, 24],
  [24, 24],
  [10, 18],
  [10, 6],
  [10, 20],
  [10, 8],
  [10, 10],
  [14, 14],
  [16, 14],
  [18, 14],
  [6, 14],
  [4, 14],
  [2, 14],
  [10, 22],
  [8, 16],
  [8, 12],
  [12, 12],
  [12, 16],
  [10, 14],
] as const;
---

<footer class:list={["w-full border-t border-[var(--color-divider)] pb-[16px] pt-[24px] sm:pb-[18px] sm:pt-[32px] lg:pb-[20px] lg:pt-[40px]", { "work-footer": workPage, "home-footer": homePage || aboutPage }]} aria-labelledby="site-footer-title">
  <h2 id="site-footer-title" class="sr-only">Stopka strony</h2>

  <div class="page-container">
    <div class="flex flex-col gap-[24px] sm:gap-[32px] lg:gap-[40px]">
      <div class="footer-columns">
        <div class="relative size-[32px] lg:size-[40px]" aria-hidden="true">
          {
            mobileDots.map(([left, top]) => (
              <span class="absolute size-[2px] bg-[var(--color-text)] lg:hidden" style={`left:${left}px;top:${top}px;`}></span>
            ))
          }
          {
            desktopDots.map(([left, top]) => (
              <span class="absolute hidden size-[2.5px] bg-[var(--color-text)] lg:block" style={`left:${left}px;top:${top}px;`}></span>
            ))
          }
        </div>

        <nav aria-label="Nawigacja stopki">
          <ul class="flex w-max flex-col items-start gap-[12px] text-[14px] leading-[24px] text-[var(--color-text)] lg:text-[16px] lg:leading-[32px]">
            {
              footerNav.map((item) => (
                <li>
                  <a href={item.href} class="px-[10px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-text)]">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <ul class="flex flex-col items-start gap-[12px] text-[14px] leading-[24px] text-[var(--color-text)] lg:text-[16px] lg:leading-[32px]">
            {
              socialLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-[12px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-text)]"
                  >
                    <span>{item.label}</span>
                    <TablerIcon
                      name="arrow-up-right"
                      class="size-6 transition-transform duration-200 group-hover:-translate-y-[1px] group-hover:translate-x-[1px] lg:size-8"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div id="footer-contact" class="footer-contact">
          <a class="footer-contact__title" href={contactMailto}>Napisz do mnie</a>
          <div class="footer-contact__email">
            <span data-footer-email>{contactEmail}</span>
            <button type="button" class="btn-icon" aria-label="Skopiuj adres e-mail" data-footer-copy-email>
              <span data-footer-copy-icon><TablerIcon name="copy" class="size-5" /></span>
              <span data-footer-copy-check hidden><TablerIcon name="copy-check" class="size-5" /></span>
            </button>
          </div>
          <span role="status" class="footer-contact__status" data-footer-copy-status></span>
        </div>
      </div>

      <div class="flex items-center justify-between text-[12px] leading-[16px] text-[var(--color-text)] lg:text-[14px] lg:leading-[19px]">
        <a
          href="https://github.com/mszczecinska/portfolio"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-[6px] text-[var(--color-text-muted)] transition-colors duration-200 hover:text-[var(--color-text)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-text)]"
        >
          <span>developed by me</span>
          <TablerIcon name="arrow-narrow-right" class="size-4 transition-transform duration-200 group-hover:translate-x-[2px]" />
        </a>
        <p>
          &copy; Magdalena Szczecińska {currentYear}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-columns { display: grid; grid-template-columns: auto auto auto; align-items: start; justify-content: space-between; gap: var(--space-8) var(--space-4); }
  .footer-contact { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); min-width: 0; font-size: var(--text-small); }
  .footer-contact__title { font-size: var(--text-body); line-height: 2rem; }
  .footer-contact__email { display: flex; align-items: center; gap: var(--space-2); max-width: 100%; }
  .footer-contact__email > span { min-width: 0; overflow-wrap: anywhere; }
  .footer-contact a { overflow-wrap: anywhere; }
  .footer-contact__status { color: var(--color-text-muted); }
  .footer-contact .btn-icon { cursor: pointer; }
  @media (max-width: 63.999rem) {
    .home-footer a[href="https://github.com/mszczecinska/portfolio"] { display: none; }
    .home-footer > div > div > div:last-child { justify-content: flex-end; }
    .home-footer :global(svg) { width: 16px; height: 16px; }
  }
  @media (min-width: 64rem) {
    .footer-columns { grid-template-columns: minmax(40px, .7fr) minmax(100px, 1fr) minmax(100px, 1fr) minmax(260px, 1.4fr); column-gap: var(--space-6); }
    .footer-contact { grid-column: auto; }
    .home-footer > div > div > div:first-child { padding-block: var(--space-6); }
    .home-footer nav ul { line-height: 32px; }
    .home-footer :global(svg) { width: 24px; height: 24px; }
  }
  @media (min-width: 64rem) {
    .work-footer { border-top: 0; padding-top: 60px; }
    .work-footer > div > div { gap: 60px; }
    .work-footer :global(svg) { width: 24px; height: 24px; }
  }
</style>

<script>
  function setupFooterEmail() {
    const button = document.querySelector<HTMLButtonElement>('[data-footer-copy-email]');
    const status = document.querySelector<HTMLElement>('[data-footer-copy-status]');
    if (!button || !status || button.dataset.initialized) return;
    button.dataset.initialized = 'true';
    const copyIcon = button.querySelector<HTMLElement>('[data-footer-copy-icon]')!;
    const checkIcon = button.querySelector<HTMLElement>('[data-footer-copy-check]')!;
    let resetTimer: ReturnType<typeof setTimeout>;
    const reset = () => {
      copyIcon.hidden = false;
      checkIcon.hidden = true;
      status.textContent = '';
      button.setAttribute('aria-label', 'Skopiuj adres e-mail');
    };
    button.addEventListener('click', async () => {
      const email = button.previousElementSibling;
      if (!(email instanceof HTMLElement)) return;
      try {
        await navigator.clipboard.writeText(email.textContent?.trim() ?? '');
        clearTimeout(resetTimer);
        copyIcon.hidden = true;
        checkIcon.hidden = false;
        status.textContent = 'Skopiowano adres';
        button.setAttribute('aria-label', 'Skopiowano adres e-mail');
        resetTimer = setTimeout(reset, 3000);
      } catch {
        clearTimeout(resetTimer);
        reset();
        status.textContent = 'Zaznacz i skopiuj adres e-mail.';
      }
    });
    document.addEventListener('astro:before-swap', () => clearTimeout(resetTimer), { once: true });
  }
  setupFooterEmail();
  document.addEventListener('astro:page-load', setupFooterEmail);
</script>
