---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  label: string;
  ratio?: string;
  desktopRatio?: string;
  src?: string | ImageMetadata;
  kind?: "image" | "video";
  sizes?: string;
  priority?: boolean;
  fit?: "contain" | "cover";
  phoneFrame?: boolean;
  zoomable?: boolean;
  zoomSrc?: string;
}

const { label, ratio = "1 / 1", desktopRatio = ratio, src, kind = "image", sizes = "(min-width: 1280px) 1216px, (min-width: 768px) calc(100vw - 64px), calc(100vw - 32px)", priority = false, fit = "contain", phoneFrame = false } = Astro.props;
const zoomSource = Astro.props.zoomable && src && kind === "image"
  ? Astro.props.zoomSrc ?? (typeof src === "string" ? src : src.src)
  : undefined;
---

<figure class:list={["case-media", { "case-media--phone": phoneFrame }]} style={`--media-ratio: ${ratio}; --media-ratio-desktop: ${desktopRatio}; --media-fit: ${fit};`}>
  <div class="case-media__content">
  {src ? (
    kind === "video" && typeof src === "string" ? (
      <div class="case-video" data-video-player>
        <video poster={src.replace(/\.mp4$/, ".poster.webp")} data-autoplay autoplay loop muted controls playsinline preload="metadata" aria-label={label}>
          <source src={src.replace(/\.mp4$/, ".webm")} type="video/webm" />
          <source src={src} type="video/mp4" />
          <a href={src}>Otwórz film</a>
        </video>
        <button class="case-video__play" type="button" data-video-play aria-label={`Odtwórz film: ${label}`}>
          <span aria-hidden="true">▶</span> Odtwórz film
        </button>
        <p class="case-video__error" data-video-error role="status" hidden>
          <span data-video-error-message>Nie udało się odtworzyć filmu.</span>
          <a href={src} target="_blank" rel="noopener">Otwórz plik MP4</a>
        </p>
      </div>
    ) : typeof src !== "string" ? (
      <Picture
        src={src}
        alt={label}
        formats={["avif", "webp"]}
        fallbackFormat={src.format === "png" ? "png" : "jpg"}
        widths={[480, 800, 1200, 1600, 2400].filter(width => width < Math.min(src.width, 2400)).concat(Math.min(src.width, 2400))}
        width={Math.min(src.width, 2400)}
        sizes={sizes}
        quality={85}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
    ) : (
      <img src={src} alt={label} loading="lazy" decoding="async" />
    )
  ) : (
    <div class="media-placeholder case-media__placeholder" role="img" aria-label={`${label} — materiał w przygotowaniu`}>
      <span class="type-label">{label}</span>
    </div>
  )}
  </div>
  {zoomSource && <a class="case-media__zoom" href={zoomSource} data-astro-reload data-image-zoom data-image-label={label} aria-label={`Powiększ obraz: ${label}`} aria-haspopup="dialog">
    <span class="case-media__zoom-hint">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6M7 10h6M10 7v6" /></svg>
      Powiększ
    </span>
  </a>}
</figure>

<style>
  .case-media__zoom { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-end; padding: var(--space-3); color: var(--color-text); cursor: zoom-in; }
  .case-media__zoom:focus-visible { outline-offset: -3px; }
  .case-media__zoom-hint { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border); background: var(--color-background); font-family: var(--font-label); font-size: 12px; text-transform: uppercase; transition: background-color var(--duration-ui) var(--ease-ui), color var(--duration-ui) var(--ease-ui); }
  .case-media__zoom:focus-visible .case-media__zoom-hint { background: var(--color-text); color: var(--color-background); }
  @media (hover: hover) {
    .case-media__zoom:hover .case-media__zoom-hint { background: var(--color-text); color: var(--color-background); }
  }
  .case-media {
    position: relative;
    width: 100%;
    min-width: 0;
    margin: 0;
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
  }
  .case-media__content {
    position: absolute;
    inset: 0;
    min-width: 0;
    min-height: 0;
  }
  .case-media__placeholder {
    width: 100%;
    height: 100%;
    padding: var(--space-5);
    text-align: center;
  }
  .case-media--phone {
    box-sizing: border-box;
    border: 1px solid var(--color-text);
    border-radius: 9.3% / 4.5%;
    background: var(--color-background);
  }
  .case-media--phone .case-media__content {
    /* Insets resolve against this phone, rather than the gallery's width. */
    inset: 2.1148% 4.9689%;
    border-radius: 5.5% / 2.5%;
    overflow: hidden;
  }
  .case-media--phone video { border-radius: 5.5% / 2.5%; }
  .case-video { position: relative; width: 100%; height: 100%; }
  .case-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: max-content;
    max-width: calc(100% - 16px);
    min-height: var(--control-height);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-small);
    cursor: pointer;
  }
  .case-video__play[hidden] { display: none; }
  .case-video__error {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 56px;
    padding: var(--space-3);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-small);
  }
  .case-video__error[hidden] { display: none; }
  .case-video__error a { text-decoration: underline; }
  .case-media :global(picture), .case-media :global(img), .case-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--media-fit);
  }
  @media (min-width: 64rem) {
    .case-media { aspect-ratio: var(--media-ratio-desktop); }
  }
</style>
