---
interface Props {
  id: string;
  title?: string;
  label?: string;
  contained?: boolean;
  subtitle?: string;
  layout?: "split" | "editorial" | "centered";
  mediaSide?: "left" | "right";
  align?: "start" | "center";
  mediaWidth?: "equal" | "wide";
  mediaFirstMobile?: boolean;
}

const { id, title, label, contained = true, subtitle, layout = "editorial", mediaSide = "right", align = "start", mediaWidth = "equal", mediaFirstMobile = false } = Astro.props;
---

<section
  class:list={["case-section", `case-section--${layout}`, { "page-container": contained, "case-section--media-left": mediaSide === "left", "case-section--center": align === "center", "case-section--wide-media": mediaWidth === "wide" }]}
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-label={title ? undefined : label}
>
  <div class="case-section__layout">
    {mediaFirstMobile && Astro.slots.has("media") && <div class="case-section__media"><slot name="media" /></div>}
    <div class="case-section__copy">
      {(title || Astro.slots.has("heading-extra")) && <div class="case-section__heading">
        <h2 class="case-heading entry-mask" id={`${id}-title`} data-case-entry><span data-entry-reveal>{title}{subtitle && <span class="case-section__subtitle"> {subtitle}</span>}</span></h2>
        <slot name="heading-extra" />
      </div>}
      <div class="case-prose" data-case-entry><slot /></div>
    </div>
    {!mediaFirstMobile && Astro.slots.has("media") && <div class="case-section__media"><slot name="media" /></div>}
  </div>
  {Astro.slots.has("visuals") && <div class="case-section__visuals"><slot name="visuals" /></div>}
</section>

<style>
  .case-section, .case-section__copy {
    display: flex;
    flex-direction: column;
    gap: var(--content-gap);
  }
  .case-section__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--content-gap);
  }
  .case-section__copy, .case-section__media, .case-section__visuals { min-width: 0; }
  .case-section__heading { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); min-width: 0; }
  .case-section__subtitle { display: block; }
  @media (min-width: 64rem) {
    .case-section--split > .case-section__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--column-gap);
    }
    .case-section--split > .case-section__layout > .case-section__copy { grid-column: 1; grid-row: 1; }
    .case-section--split > .case-section__layout > .case-section__media { grid-column: 2; grid-row: 1; }
    .case-section--wide-media > .case-section__layout { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .case-section--wide-media.case-section--media-left > .case-section__layout { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .case-section--media-left > .case-section__layout > .case-section__media { grid-column: 1; grid-row: 1; }
    .case-section--media-left > .case-section__layout > .case-section__copy { grid-column: 2; grid-row: 1; }
    .case-section--center > .case-section__layout > .case-section__copy { align-self: center; }
    .case-section--editorial > .case-section__layout > .case-section__copy {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-5);
    }
    .case-section--centered > .case-section__layout > .case-section__copy {
      display: grid;
      grid-template-columns: max-content minmax(0, 37.375rem);
      gap: var(--space-20);
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
    }
  }
</style>
