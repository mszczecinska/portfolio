---
import CaseStudyFacts from "./CaseStudyFacts.astro";
import TablerIcon from "../TablerIcon.astro";
import CaseStudyMedia from "./CaseStudyMedia.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  cover?: ImageMetadata;
  subtitle: string;
  overview: string;
  role: string;
  roleLabel?: string;
  projectType: string;
  tools: readonly { src: string; alt: string }[];
  liveUrl?: string;
  showLiveInfo?: boolean;
  liveHoverColor?: string;
  liveHoverTextColor?: string;
  liveHoverBorderColor?: string;
  facts?: readonly { title: string; text: string }[];
}
const { title, cover, subtitle, overview, role, roleLabel = "Rola", projectType, tools, liveUrl, showLiveInfo = false, liveHoverColor = "var(--color-surface)", liveHoverTextColor = "var(--color-text)", liveHoverBorderColor = "var(--color-text)", facts = [] } = Astro.props;
---

<header class="case-intro">
  <div class="page-container">
    <CaseStudyMedia src={cover} priority fit="cover" label={`${title} — okładka projektu`} ratio="361 / 186" desktopRatio="1216 / 520" />
  </div>

  <div class="case-intro__details page-container">
    <div class="case-intro__heading">
      <div class="case-intro__titles">
        <h1 id="case-study-title" class="type-title">{title}</h1>
        <p class="case-intro__subtitle">{subtitle}</p>
      </div>
      {liveUrl && <div class="case-intro__live" data-live-info={showLiveInfo ? true : undefined}>
        <a class="btn-primary" style={`--case-live-hover: ${liveHoverColor}; --case-live-hover-text: ${liveHoverTextColor}; --case-live-hover-border: ${liveHoverBorderColor};`} href={liveUrl} target="_blank" rel="noopener noreferrer">Zobacz live <TablerIcon name="arrow-up-right" class="size-6" /></a>
        {showLiveInfo && <><button class="case-intro__info" type="button" aria-label="Informacja o wdrożonej stronie" aria-describedby="live-site-info" data-live-info-trigger>
          <TablerIcon name="info-circle" class="size-5" />
        </button>
        <span class="case-intro__tooltip" id="live-site-info" role="tooltip" hidden>Wdrożona strona może różnić się od prezentowanego projektu.</span></>}
      </div>}
    </div>

    <div class="case-intro__overview">
      <dl class="case-intro__metadata">
        <div><dt class="type-label">{roleLabel}</dt><dd>{role}</dd></div>
        <div><dt class="type-label">Typ</dt><dd>{projectType}</dd></div>
        <div>
          <dt class="type-label">Narzędzia</dt>
          <dd><ul class="case-intro__tools" aria-label="Narzędzia projektu">{tools.map(tool => <li><img src={tool.src} alt={tool.alt} width="24" height="24" /></li>)}</ul></dd>
        </div>
      </dl>
      <p class="case-body">{overview}</p>
    </div>
  </div>

  {facts.length > 0 && <CaseStudyFacts items={facts} />}
</header>

<style>
  .case-intro__live { position: relative; display: flex; align-items: center; gap: var(--space-2); max-width: 100%; }
  .case-intro__info { display: grid; place-items: center; width: var(--control-height); height: var(--control-height); flex: none; color: var(--color-text-muted); cursor: help; }
  .case-intro__info:focus-visible { outline: 2px solid var(--color-text); outline-offset: 2px; }
  .case-intro__tooltip { position: absolute; z-index: 10; left: 0; bottom: calc(100% + var(--space-2)); width: min(20rem, calc(100vw - 2 * var(--page-gutter))); padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); background: var(--color-background); color: var(--color-text); font-size: var(--text-small); line-height: 1.5; }
  @media (hover: hover) {
    .case-intro__heading .btn-primary:hover {
      background-color: var(--case-live-hover);
      color: var(--case-live-hover-text);
      border-color: var(--case-live-hover-border);
    }
  }
  .case-intro { display: flex; flex-direction: column; gap: var(--space-6); }
  .case-intro > .page-container:first-child { margin-bottom: calc(-1 * var(--space-4)); }
  .case-intro__details { display: grid; gap: var(--space-5); }
  .case-intro__heading, .case-intro__overview { display: flex; flex-direction: column; gap: var(--space-5); min-width: 0; }
  .case-intro__heading { align-items: flex-start; gap: var(--space-4); }
  .case-intro__titles { display: grid; gap: var(--space-2); width: 100%; }
  .case-intro__subtitle { font-size: 1.5rem; line-height: var(--leading-heading); }
  .case-intro__metadata { margin: 0; }
  .case-intro__metadata > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.16fr);
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }
  .case-intro__metadata > div:last-child { border-bottom: var(--border-width) solid var(--color-border); }
  .case-intro__metadata dd { margin: 0; font-size: var(--text-small); line-height: var(--leading-body); }
  .case-intro__tools { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .case-intro__tools img { display: block; width: var(--space-5); height: var(--space-5); object-fit: contain; }
  @media (min-width: 64rem) {
    .case-intro { gap: var(--space-10); }
    .case-intro > .page-container:first-child { margin-bottom: 0; }
    .case-intro__details { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
    .case-intro__heading { align-items: flex-start; gap: var(--space-8); }
    .case-intro__subtitle { font-size: var(--text-heading); }
    .case-intro__metadata { max-width: 34.5rem; }
    .case-intro__metadata > div { grid-template-columns: minmax(0, 156fr) minmax(0, 372fr); }
    .case-intro__metadata dd { font-size: var(--text-body); }
    .case-intro__tools img { width: var(--space-6); height: var(--space-6); }
    .case-intro__tools { gap: var(--space-5); }
  }
</style>

<script>
  function setupLiveInfo() {
    document.querySelectorAll<HTMLElement>("[data-live-info]").forEach(root => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = "true";
      const trigger = root.querySelector<HTMLButtonElement>("[data-live-info-trigger]")!;
      const tooltip = root.querySelector<HTMLElement>('[role="tooltip"]')!;
      const show = () => {
        const buttonRect = trigger.getBoundingClientRect();
        const rootRect = root.getBoundingClientRect();
        const headingRect = root.parentElement!.getBoundingClientRect();
        const availableWidth = headingRect.right - buttonRect.right - 8;
        const beside = availableWidth >= 160;
        tooltip.style.left = beside ? `${buttonRect.right - rootRect.left + 8}px` : '0px';
        tooltip.style.top = beside ? `${buttonRect.top - rootRect.top + buttonRect.height / 2}px` : 'calc(100% + 8px)';
        tooltip.style.bottom = 'auto';
        tooltip.style.transform = beside ? 'translateY(-50%)' : 'none';
        tooltip.style.width = `${Math.min(320, beside ? availableWidth : headingRect.width)}px`;
        tooltip.hidden = false;
      };
      const hide = () => { tooltip.hidden = true; };
      let wasOpenOnPointerDown = false;
      trigger.addEventListener("pointerenter", event => {
        if (event.pointerType !== "touch") show();
      });
      trigger.addEventListener("pointerleave", hide);
      trigger.addEventListener("pointerdown", () => {
        wasOpenOnPointerDown = !tooltip.hidden;
      });
      trigger.addEventListener("focus", () => {
        if (trigger.matches(":focus-visible")) show();
      });
      trigger.addEventListener("blur", hide);
      trigger.addEventListener("click", event => {
        const shouldHide = event.detail === 0 ? !tooltip.hidden : wasOpenOnPointerDown;
        if (shouldHide) hide();
        else show();
      });
      const onPointerDown = (event: PointerEvent) => {
        if (event.target instanceof Node && !trigger.contains(event.target) && !tooltip.contains(event.target)) hide();
      };
      const onKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape") hide();
      };
      document.addEventListener("keydown", onKeydown);
      document.addEventListener("pointerdown", onPointerDown);
      document.addEventListener("astro:before-swap", () => {
        document.removeEventListener("keydown", onKeydown);
        document.removeEventListener("pointerdown", onPointerDown);
      }, { once: true });
    });
  }
  setupLiveInfo();
  document.addEventListener("astro:page-load", setupLiveInfo);
</script>
