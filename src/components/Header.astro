---
import { languageFromPath, languagePath, withoutLanguage } from "../i18n/routes";
import TablerIcon from "./TablerIcon.astro";
import LogoIcon from "./LogoIcon.astro";
import { contactMailto } from "../lib/contact";

interface Props { caseStudy?: boolean; workPage?: boolean; homePage?: boolean; aboutPage?: boolean; }
const { caseStudy = false, workPage = false, homePage = false, aboutPage = false } = Astro.props;

const navItems = [
  { key: "work", href: "/work", label: "Realizacje" },
  { key: "about", href: "/about", label: "O mnie" },
] as const;

const mobileNavItems = [
  { key: "home", href: "/", label: "Główna" },
  ...navItems,
] as const;

const language = languageFromPath(Astro.url.pathname);
const currentPath = withoutLanguage(Astro.url.pathname);
const targetLanguage = language === "pl" ? "en" : "pl";
const switchPath = languagePath(Astro.url.pathname, targetLanguage);
const activeKey = currentPath === "/"
  ? "home"
  : currentPath.startsWith("/about")
  ? "about"
  : currentPath.startsWith("/work")
    ? "work"
    : null;
const mobileSectionLabel = mobileNavItems.find((item) => item.key === activeKey)?.label ?? "Menu";
---

<header class:list={["relative z-40", { "case-header": caseStudy || workPage || homePage || aboutPage, "work-header": workPage, "home-header": homePage, "about-header": aboutPage }]} data-scroll-header>
  <div class="page-container pt-[var(--space-5)]">
    <nav class="flex items-center justify-between lg:min-h-[140px] lg:items-start" aria-label="Główna nawigacja">
      <a
        href="/"
        class="header-menu-link hidden items-center lg:inline-flex lg:py-[12px]"
        aria-label="Strona główna"
        aria-current={homePage ? "page" : undefined}
        transition:persist={`${language}-${homePage ? "home-brand" : caseStudy || workPage ? "case-brand" : "site-brand"}`}
      >
        {caseStudy || workPage || homePage || aboutPage ? <span class="case-header__home">Główna</span> : (
        <span class="h-[16px] w-auto lg:h-[18px] text-[var(--color-text)]">
          <LogoIcon class="size-6" />
        </span>
        )}
      </a>

      {caseStudy && <a href="/work" class="case-header__current" aria-label="Wróć do realizacji">Realizacje</a>}
      {workPage && <a href="/work" class="case-header__current" aria-current="page">Work</a>}
      {aboutPage && <a href="/about" class="case-header__current" aria-current="page">O mnie</a>}
      {homePage && <a href="/" class="case-header__current" aria-current="page">Główna</a>}

      <div class="flex w-full items-center justify-between lg:w-auto lg:items-start lg:gap-[64px]" data-mobile-menu>
        <ul class="hidden items-start pt-[12px] self-center gap-[64px] text-[var(--color-text)] lg:flex">
          {
            navItems.map((item) => {
              const isActive = item.key === activeKey;

              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive ? "page" : undefined}
                    class="header-menu-link type-nav font-normal leading-none block whitespace-nowrap transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-text)]"
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="lg:hidden">
          <button
            type="button"
            data-mobile-toggle
            class="mobile-menu-trigger type-nav focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-text)]"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
          >
            <span>{mobileSectionLabel}</span>
            <TablerIcon name="chevron-down" class="size-4 shrink-0" strokeWidth={1.5} />
          </button>
        </div>

        <div class="header-actions">
          <a href={switchPath} class="home-header__language btn-icon" data-language-switch aria-label="Zmień język na angielski" hreflang={targetLanguage} lang={language}>{targetLanguage.toUpperCase()}</a>
          <a href={contactMailto} class="header-email btn-secondary">Napisz do mnie</a>
        </div>
        <div class="contents lg:hidden">
          <div
            class="fixed inset-0 z-[90] overflow-clip pointer-events-none"
            data-mobile-overlay
            style={{ "--mobile-menu-last-order": mobileNavItems.length }}
            aria-hidden="true"
            inert
          >
            <div data-mobile-backdrop></div>
            <div
              id="mobile-menu-panel"
              data-mobile-panel
            >
              <span id="mobile-menu-title" class="sr-only">Menu nawigacji</span>

              <ul class="mobile-menu-links">
                {
                  mobileNavItems.map((item, index) => {
                    const isActive = item.key === activeKey;

                    return (
                      <li style={{ "--mobile-menu-order": index }}>
                        <a
                          href={item.href}
                          data-mobile-link
                          data-mobile-page-link
                          aria-current={isActive ? "page" : undefined}
                          class="type-heading mobile-menu-link"
                        >
                          <span class="entry-mask"><span class="mobile-menu-reveal">{item.label}</span></span>
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
              <div class="mobile-menu-contact" style={{ "--mobile-menu-order": mobileNavItems.length }}>
                <div class="mobile-menu-reveal">
                  <a href={contactMailto} data-mobile-link class="btn-primary">
                    <span>Napisz do mnie</span>
                    <TablerIcon name="arrow-up-right" class="size-6 shrink-0" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const STATE_KEY = "__portfolioMobileMenuState";
    const state = window[STATE_KEY] ?? (window[STATE_KEY] = {});

    const focusablesSelector =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    const setup = () => {
      if (typeof state.cleanup === "function") {
        state.cleanup();
      }

      const closingTransitions = new WeakMap();
      const controller = new AbortController();
      const { signal } = controller;

      const getRoot = (target) =>
        target instanceof Element ? target.closest("[data-mobile-menu]") : null;

      const getRoots = () => Array.from(document.querySelectorAll("[data-mobile-menu]"));

      const getElements = (root) => ({
        toggleButton: root.querySelector("[data-mobile-toggle]"),
        overlay: root.querySelector("[data-mobile-overlay]"),
        panel: root.querySelector("[data-mobile-panel]"),
      });

      const isOpen = (root) => {
        const { toggleButton } = getElements(root);
        return toggleButton?.getAttribute("aria-expanded") === "true";
      };

      const syncBodyScrollLock = () => {
        const hasOpenMenu = getRoots().some((root) => isOpen(root) || closingTransitions.has(root));
        document.body.classList.toggle("mobile-menu-open", hasOpenMenu);
      };

      const closeMenu = (root, restoreFocus = true, immediate = false) => {
        const { toggleButton, overlay } = getElements(root);
        if (!toggleButton || !overlay) return;

        root.classList.toggle("is-instant", immediate);
        if (immediate) closingTransitions.get(root)?.cancel();
        closingTransitions.delete(root);

        toggleButton.setAttribute("aria-expanded", "false");
        root.classList.remove("is-open");
        root.removeAttribute("role");
        root.removeAttribute("aria-modal");
        root.removeAttribute("aria-labelledby");

        if (restoreFocus) toggleButton.focus({ preventScroll: true });
        overlay.setAttribute("inert", "");
        overlay.setAttribute("aria-hidden", "true");

        const exitTransition = immediate ? undefined : overlay.getAnimations().find(
          (animation) => animation.transitionProperty === "clip-path"
        );
        if (exitTransition) {
          // Keep the page still while the overlay retracts.
          closingTransitions.set(root, exitTransition);
          const finishClose = () => {
            if (closingTransitions.get(root) !== exitTransition) return;
            closingTransitions.delete(root);
            syncBodyScrollLock();
          };
          exitTransition.finished.then(finishClose, finishClose);
        }
        syncBodyScrollLock();
      };

      const closeAllMenus = (restoreFocus = false, immediate = false) => {
        getRoots().forEach((root) => {
          if (isOpen(root) || (immediate && closingTransitions.has(root))) {
            closeMenu(root, restoreFocus, immediate);
          }
        });
      };

      const openMenu = (root, immediate) => {
        const { toggleButton, overlay, panel } = getElements(root);
        if (!toggleButton || !overlay || !panel) return;

        closeAllMenus(false);
        closingTransitions.delete(root);
        panel.scrollTop = 0;

        root.classList.toggle("is-instant", immediate);
        toggleButton.setAttribute("aria-expanded", "true");
        overlay.removeAttribute("aria-hidden");
        overlay.removeAttribute("inert");
        root.setAttribute("role", "dialog");
        root.setAttribute("aria-modal", "true");
        root.setAttribute("aria-labelledby", "mobile-menu-title");
        root.classList.add("is-open");

        syncBodyScrollLock();
        toggleButton.focus({ preventScroll: true });
      };

      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const toggle = target.closest("[data-mobile-toggle]");
          if (toggle) {
            const root = getRoot(toggle);
            if (!root) return;

            const immediate = event.detail === 0;
            if (isOpen(root)) closeMenu(root, true, immediate);
            else openMenu(root, immediate);
            return;
          }

          const navLink = target.closest("[data-mobile-link]");
          if (navLink instanceof HTMLAnchorElement && !event.defaultPrevented && event.button === 0
            && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
            const root = getRoot(navLink);
            if (!root) return;

            if (!navLink.hasAttribute("data-mobile-page-link")) {
              closeMenu(root, true, true);
            } else if (navLink.href === location.href) {
              event.preventDefault();
              closeMenu(root, true, event.detail === 0);
            }
          }
        },
        { capture: true, signal }
      );

      document.addEventListener(
        "keydown",
        (event) => {
          const root = getRoots().find((menuRoot) => isOpen(menuRoot));
          if (!root) return;

          if (event.key === "Escape") {
            event.preventDefault();
            closeMenu(root, true, true);
            return;
          }

          if (event.key !== "Tab") return;

          const menuFocusable = Array.from(root.querySelectorAll(focusablesSelector)).filter(
            (element) =>
              element instanceof HTMLElement &&
              !element.hasAttribute("disabled") &&
              element.tabIndex !== -1 &&
              element.getClientRects().length > 0
          );

          if (menuFocusable.length === 0) return;

          const first = menuFocusable[0];
          const last = menuFocusable[menuFocusable.length - 1];

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        },
        { signal }
      );

      window.addEventListener(
        "resize",
        () => {
          if (window.matchMedia("(min-width: 1024px)").matches) {
            closeAllMenus(false, true);
          }
        },
        { signal }
      );

      document.addEventListener(
        "astro:before-swap",
        (event) => {
          // Keep the panel in the outgoing frame instead of revealing the old page.
          const swap = event.swap;
          event.swap = () => {
            closeAllMenus(false, true);
            swap();
          };
        },
        { signal }
      );

      state.cleanup = () => {
        closeAllMenus(false, true);
        controller.abort();
      };
    };

    if (!state.pageLoadBound) {
      document.addEventListener("astro:page-load", setup);
      state.pageLoadBound = true;
    }

    setup();
  })();
</script>

<style>
  .header-actions { display: contents; }
  .header-email { display: none; white-space: nowrap; }
  @media (min-width: 64rem) {
    .header-actions { display: inline-flex; align-items: center; gap: var(--space-2); }
    .header-email {
      display: inline-flex;
      flex-shrink: 0;
      /* Reserve room for the longer Polish label in both languages. */
      inline-size: calc(14ch + 2 * (var(--space-6) + var(--border-width)));
    }
  }
  .about-header nav > div { gap: var(--space-2); }
  @media (min-width: 64rem) {
    .about-header nav > div, .about-header nav ul, .about-header nav li { display: contents; }
    .about-header nav :global(.type-nav:not([aria-current="page"])) { color: var(--color-text-muted); }
  }
  .home-header nav { gap: var(--space-10); }
  .home-header nav > div { flex: none; }
  .home-header .case-header__current { font-weight: var(--weight-regular); }
  .home-header__language { width: 44px; height: 44px; padding: 10px; font-family: var(--font-label); font-size: 16px; line-height: 1; cursor: pointer; }
  @media (max-width: 1023px) {
    .home-header__language { z-index: 91; }
  }
  @media (min-width: 64rem) {
    .header-actions > .home-header__language,
    .header-actions > .header-email { height: 3.5rem; min-height: 3.5rem; padding-block: 0; }
    .header-actions > .home-header__language { width: 3.5rem; min-width: 3.5rem; padding-inline: 0; font-size: var(--text-body); }
  }
  .home-header nav > div { gap: var(--space-2); }
  @media (min-width: 64rem) {
    .home-header nav { justify-content: space-between; }
    .home-header nav > div, .home-header nav ul, .home-header nav li { display: contents; }
    .home-header nav :global(.type-nav) { color: var(--color-text-muted); }
    .home-header .case-header__home { font-size: 2rem; line-height: 3.5rem; color: var(--color-text); }
  }
  .work-header__language { display: grid; place-items: center; width: 44px; height: 44px; font-family: var(--font-label); line-height: 1; }
  .work-header nav > div { gap: var(--space-2); }
  .work-header .case-header__current { font-weight: var(--weight-regular); }
  @media (min-width: 64rem) {
    .work-header nav :global(.type-nav:not([aria-current="page"])) { color: var(--color-text-muted); }
    .work-header nav > div, .work-header nav ul, .work-header nav ul li { display: contents; }
  }
  .case-header > div { padding-block: var(--space-3); }
  .case-header[data-scroll-header].is-floating > div { padding-bottom: var(--space-3); }
  .case-header nav { min-height: var(--control-height); align-items: center; }
  .case-header nav > a:first-child { display: none; }
  .case-header__current { display: none; font-size: 1.5rem; font-weight: var(--weight-regular); }
  @media (min-width: 64rem) {
    .case-header > div { padding-block: var(--space-5); }
    .case-header[data-scroll-header].is-floating > div { padding-bottom: var(--space-5); }
    .case-header nav { min-height: 3.5rem; justify-content: space-between; gap: clamp(var(--space-6), 3vw, var(--space-10)); }
    .case-header nav > a:first-child { display: inline-flex; padding-block: 0; }
    .case-header__home { font-size: 1.25rem; color: var(--color-text-muted); }
    .case-header__current { display: none; }
    .case-header nav > div,
    .case-header nav > div > ul,
    .case-header nav > div > ul > li { display: contents; }
    .header-menu-link { transform-origin: left center; }
  }

  [data-scroll-header] {
    position: relative;
    z-index: 40;
    border-bottom: 1px solid transparent;
    opacity: 1;
    --header-float-shadow: 0 8px 24px -20px rgba(0, 0, 0, 0.28);
  }

  [data-scroll-header].is-floating {
    position: sticky;
    inset-inline: 0;
    top: 0;
    z-index: 70;
    background: var(--color-background);
    box-shadow: none;
    transition: transform 240ms var(--ease-editorial), opacity 180ms var(--ease-ui);
  }

  [data-scroll-header].is-floating.is-hidden {
    opacity: 0.01;
    transform: translateY(-100%);
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    [data-scroll-header].is-floating > div {
      padding-bottom: 36px;
    }
  }

  @media (min-width: 1024px) {
    [data-scroll-header].is-floating:not(.is-at-top) {
      box-shadow: var(--header-float-shadow);
    }
  }

  /* Release the fixed overlay from the header's transform containing block. */
  :global(body.mobile-menu-open) [data-scroll-header] {
    position: sticky;
    inset-block-start: 0;
    transform: none;
    opacity: 1;
    pointer-events: auto;
    transition: none;
  }

  [data-mobile-menu] {
    --mobile-menu-duration: 190ms;
    --mobile-menu-wipe-duration: 195ms;
    --mobile-menu-wipe-delay: 20ms;
  }
  [data-mobile-menu].is-open {
    --mobile-menu-duration: 200ms;
    --mobile-menu-wipe-duration: 220ms;
    --mobile-menu-wipe-delay: 0ms;
  }
  [data-mobile-menu].is-instant {
    --mobile-menu-duration: 0ms;
    --mobile-menu-wipe-duration: 0ms;
    --mobile-menu-wipe-delay: 0ms;
  }
  [data-mobile-overlay] {
    --mobile-menu-bar-height: max(calc(var(--control-height) + 2 * var(--space-3)), env(safe-area-inset-top));
    --mobile-menu-gutter-start: max(var(--page-gutter), env(safe-area-inset-left));
    --mobile-menu-gutter-end: max(var(--page-gutter), env(safe-area-inset-right));
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path var(--mobile-menu-wipe-duration) cubic-bezier(0.215, 0.61, 0.355, 1) var(--mobile-menu-wipe-delay),
      visibility 0s linear calc(var(--mobile-menu-wipe-duration) + var(--mobile-menu-wipe-delay));
  }

  [data-mobile-menu].is-open [data-mobile-overlay] {
    pointer-events: auto;
    visibility: visible;
    clip-path: inset(0);
    transition-delay: 0s;
  }

  .mobile-menu-trigger {
    position: relative;
    z-index: 91;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--control-height);
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-menu-trigger > :global(svg) {
    transition: rotate var(--mobile-menu-duration) var(--ease-ui);
  }

  .mobile-menu-trigger[aria-expanded="true"] > :global(svg) {
    rotate: 180deg;
  }

  [data-mobile-backdrop] {
    position: absolute;
    inset: 0;
    background: var(--color-background);
  }

  [data-mobile-backdrop]::after {
    content: "";
    position: absolute;
    inset-block-start: var(--mobile-menu-bar-height);
    inset-inline: var(--mobile-menu-gutter-start) var(--mobile-menu-gutter-end);
    border-block-start: var(--border-width) solid var(--color-divider);
  }

  [data-mobile-panel] {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-block-start: calc(var(--mobile-menu-bar-height) + var(--border-width)) solid transparent;
    padding-block-end: max(var(--space-6), env(safe-area-inset-bottom));
    padding-inline: var(--mobile-menu-gutter-start) var(--mobile-menu-gutter-end);
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--color-text);
  }

  .mobile-menu-links {
    flex: none;
    margin-block: auto;
    padding-block: var(--space-6);
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    min-block-size: var(--space-16);
    padding-block: clamp(var(--space-3), 3dvh, var(--space-6));
    font-size: var(--text-subheading);
    line-height: var(--leading-title);
  }

  .mobile-menu-link:not([aria-current="page"]) { color: var(--color-text-muted); }
  .mobile-menu-link[aria-current="page"] { font-size: var(--text-title); }

  .mobile-menu-contact {
    align-self: flex-start;
    flex: none;
  }

  .mobile-menu-reveal { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu-contact {
      overflow: clip;
      overflow-clip-margin: 6px;
    }

    [data-mobile-menu].is-open .mobile-menu-contact:focus-within {
      overflow: visible;
    }

    .mobile-menu-reveal {
      transform: translateY(calc(100% + 8px));
      transition: transform 155ms var(--ease-editorial)
        calc((var(--mobile-menu-last-order) - var(--mobile-menu-order)) * 18ms);
    }

    [data-mobile-menu].is-open .mobile-menu-reveal {
      transform: none;
      transition-duration: 310ms;
      transition-delay: calc(72ms + var(--mobile-menu-order) * 49ms);
    }

    [data-mobile-menu].is-instant .mobile-menu-reveal,
    [data-mobile-menu].is-open .mobile-menu-link:focus-visible .mobile-menu-reveal,
    [data-mobile-menu].is-open .mobile-menu-contact:focus-within .mobile-menu-reveal {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-scroll-header].is-floating { transition: none; }
    [data-mobile-overlay],
    .mobile-menu-trigger > :global(svg) { transition: none; }
  }

  [data-scroll-header].is-no-transition {
    transition: none;
  }

  :global(body.mobile-menu-open) {
    overflow: hidden;
  }
</style>

<script is:inline>
  (() => {
    const STATE_KEY = "__portfolioHeaderRevealState";
    const state =
      window[STATE_KEY] ??
      (window[STATE_KEY] = {
        pageLoadBound: false,
        cleanup: null,
      });

    const setup = () => {
      if (typeof state.cleanup === "function") {
        state.cleanup();
      }

      const header = document.querySelector("[data-scroll-header]");
      if (!(header instanceof HTMLElement)) return;
      const desktopMq = window.matchMedia("(min-width: 1024px)");
      let lastY = window.scrollY;
      let direction = "down";
      let directionDistance = 0;
      let isTicking = false;
      state.isFloating = false;
      state.isHidden = false;
      const revealAfterY = 260;
      const getMobileRevealAfterY = () => Math.max(header.offsetHeight * 0.85, 96);
      const desktopToggleDelta = 12;
      const mobileHideDelta = 28;
      const mobileShowDelta = 14;
      const getHideDelta = () => (desktopMq.matches ? desktopToggleDelta : mobileHideDelta);
      const getShowDelta = () => (desktopMq.matches ? desktopToggleDelta : mobileShowDelta);
      const getMinYToHide = () => (desktopMq.matches ? revealAfterY : Math.max(header.offsetHeight * 0.8, 88));
      let transitionResetRaf = 0;
      const applyFloatingState = () => {
        if (state.isFloating) {
          header.classList.add("is-floating");
        } else {
          header.classList.remove("is-floating");
        }
      };

      const hideImmediatelyOnEnterFloating = () => {
        if (transitionResetRaf) {
          cancelAnimationFrame(transitionResetRaf);
        }

        header.classList.add("is-no-transition");
        applyFloatingState();
        header.classList.add("is-hidden");

        transitionResetRaf = requestAnimationFrame(() => {
          transitionResetRaf = 0;
          header.classList.remove("is-no-transition");
        });
      };

      applyFloatingState();
      header.classList.toggle("is-at-top", window.scrollY <= 2);

      const processScroll = () => {
        isTicking = false;
        const currentY = window.scrollY;
        const rawDelta = currentY - lastY;
        const absDelta = Math.abs(rawDelta);

        if (document.body.classList.contains("mobile-menu-open") || header.querySelector(":focus-visible")) {
          applyFloatingState();
          header.classList.remove("is-hidden");
          state.isHidden = false;
          lastY = currentY;
          return;
        }

        if (currentY <= 2) {
          state.isFloating = false;
          state.isHidden = false;
          applyFloatingState();
          header.classList.add("is-at-top");
          header.classList.remove("is-hidden");
          direction = "down";
          directionDistance = 0;
          lastY = currentY;
          return;
        }

        if (absDelta < 1) return;
        const nextDirection = rawDelta > 0 ? "down" : "up";

        if (nextDirection === direction) {
          directionDistance += absDelta;
        } else {
          direction = nextDirection;
          directionDistance = absDelta;
        }

        header.classList.remove("is-at-top");

        if (!desktopMq.matches && !state.isFloating && currentY > getMobileRevealAfterY()) {
          state.isFloating = true;
          state.isHidden = true;
          hideImmediatelyOnEnterFloating();
          directionDistance = 0;
        }

        if (desktopMq.matches && !state.isFloating && currentY > revealAfterY) {
          state.isFloating = true;
          state.isHidden = true;
          hideImmediatelyOnEnterFloating();
          directionDistance = 0;
        }

        if (!state.isFloating) {
          applyFloatingState();
          header.classList.remove("is-hidden");
          lastY = currentY;
          return;
        }

        if (
          direction === "down" &&
          directionDistance > getHideDelta() &&
          currentY > getMinYToHide() &&
          !state.isHidden
        ) {
          state.isHidden = true;
          header.classList.add("is-hidden");
          directionDistance = 0;
        }

        if (direction === "up" && directionDistance > getShowDelta() && state.isHidden) {
          state.isHidden = false;
          header.classList.remove("is-hidden");
          directionDistance = 0;
        }

        lastY = currentY;
      };

      const onScroll = () => {
        if (isTicking) return;
        isTicking = true;
        requestAnimationFrame(processScroll);
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      const revealOnFocus = () => {
        state.isHidden = false;
        header.classList.remove("is-hidden");
      };
      header.addEventListener("focusin", revealOnFocus);
      processScroll();

      state.cleanup = () => {
        window.removeEventListener("scroll", onScroll);
        header.removeEventListener("focusin", revealOnFocus);
        if (transitionResetRaf) {
          cancelAnimationFrame(transitionResetRaf);
          transitionResetRaf = 0;
        }
        header.classList.remove("is-no-transition");
        state.isFloating = false;
        applyFloatingState();
        header.classList.add("is-at-top");
        header.classList.remove("is-hidden");
        state.isHidden = false;
      };
    };

    setup();
    if (!state.pageLoadBound) {
      document.addEventListener("astro:page-load", setup);
      state.pageLoadBound = true;
    }
  })();
</script>
