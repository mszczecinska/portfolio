---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import homePhoto from "../assets/home/home-photo.jpg";

interface Props {
  title: string;
  description?: string;
  socialImage?: ImageMetadata;
  showFooter?: boolean;
  caseStudyHeader?: boolean;
  workPage?: boolean;
  homePage?: boolean;
  aboutPage?: boolean;
}

const {
  title,
  description = "Portfolio UX/UI z płynnymi przejściami między podstronami",
  socialImage,
  showFooter = true,
  caseStudyHeader = false,
  workPage = false,
  homePage = false,
  aboutPage = false,
} = Astro.props;

import { languageFromPath, languagePath } from "../i18n/routes";
const language = languageFromPath(Astro.url.pathname);
const canonical = new URL(languagePath(Astro.url.pathname, language), Astro.site);
const pageTitle = homePage ? title : `${title} | Portfolio`;
const previewImage = await getImage({
  src: socialImage ?? homePhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 85,
});
const previewImageUrl = new URL(previewImage.src, Astro.site);

import { ClientRouter } from "astro:transitions";
import "./layout.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Magda Szczecińska" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={language === "en" ? "en_GB" : "pl_PL"} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content={previewImage.attributes.width} />
    <meta property="og:image:height" content={previewImage.attributes.height} />
    <meta property="og:image:alt" content={socialImage ? pageTitle : "Magda Szczecińska siedząca w fotelu"} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={new URL(languagePath(Astro.url.pathname, "pl"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(languagePath(Astro.url.pathname, "en"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(languagePath(Astro.url.pathname, "pl"), Astro.site)} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link id="site-favicon" rel="icon" type="image/x-icon" href="/favicon-light.ico?v=2" sizes="16x16 32x32 48x48" />
    <script is:inline>
      (() => {
        const darkTheme = window.matchMedia("(prefers-color-scheme: dark)");
        const updateFavicon = () => {
          const icon = document.getElementById("site-favicon");
          if (icon) icon.setAttribute("href", darkTheme.matches ? "/favicon-dark.ico?v=2" : "/favicon-light.ico?v=2");
        };
        updateFavicon();
        darkTheme.addEventListener("change", updateFavicon);
        document.addEventListener("astro:after-swap", updateFavicon);
      })();
    </script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Portfolio" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script>
      import "../scripts/project-transitions";
      import "../scripts/page-entry";
      import "../scripts/language-switch";
      import { startAutoplayVideos } from "../scripts/video-playback.js";

      let cleanupVideos = () => {};
      let videoPage: HTMLElement | null = null;
      const setupVideos = () => {
        if (videoPage === document.body) return;
        cleanupVideos();
        videoPage = document.body;
        cleanupVideos = startAutoplayVideos();
      };
      // Full reloads must initialize even when ClientRouter's first page-load
      // event fires before this module finishes loading.
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupVideos, { once: true });
      } else {
        setupVideos();
      }
      document.addEventListener("astro:page-load", setupVideos);
      document.addEventListener("astro:before-swap", () => {
        cleanupVideos();
        videoPage = null;
      });
    </script>
  </head>
    <body class="min-h-dvh flex flex-col bg-[var(--color-background)]">
      <a href="#main-content" class="skip-to-content">
        Przejdź do treści
      </a>
      <Header caseStudy={caseStudyHeader} workPage={workPage} homePage={homePage} aboutPage={aboutPage} />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      {showFooter && <Footer showDivider={!workPage} />}
      <Analytics />
      <SpeedInsights />
    </body>
  </html>
