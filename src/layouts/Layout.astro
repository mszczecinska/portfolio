---
interface Props {
  title: string;
  description?: string;
  showFooter?: boolean;
  caseStudyHeader?: boolean;
  workPage?: boolean;
  homePage?: boolean;
  aboutPage?: boolean;
}

const {
  title,
  description = "Portfolio UX/UI z płynnymi przejściami między podstronami",
  showFooter = true,
  caseStudyHeader = false,
  workPage = false,
  homePage = false,
  aboutPage = false,
} = Astro.props;

import { ClientRouter } from "astro:transitions";
import "./layout.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon-light.ico"  media="(prefers-color-scheme:light)" />
    <link rel="shortcut icon" href="/favicon-dark.ico"  media="(prefers-color-scheme:dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Portfolio" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <title>{title} | Portfolio</title>
    <ClientRouter />
    <script>
      import { startAutoplayVideos } from "../scripts/video-playback.js";

      let cleanupVideos = () => {};
      let videoPage: HTMLElement | null = null;
      const setupVideos = () => {
        if (videoPage === document.body) return;
        cleanupVideos();
        videoPage = document.body;
        cleanupVideos = startAutoplayVideos();
      };
      // Full reloads must initialize even when ClientRouter's first page-load
      // event fires before this module finishes loading.
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupVideos, { once: true });
      } else {
        setupVideos();
      }
      document.addEventListener("astro:page-load", setupVideos);
      document.addEventListener("astro:before-swap", () => {
        cleanupVideos();
        videoPage = null;
      });
    </script>
    <script is:inline>
      const PROJECT_SCROLL_STATE_KEY = "__portfolioProjectScrollState";

      function isProjectDetailPath(pathname) {
        return /^\/(?:work|project)\/[^/]+\/?$/.test(pathname);
      }

      function canRestoreProjectScroll(pathname) {
        return pathname === "/" || pathname === "/work";
      }

      function saveProjectScrollPosition(link) {
        if (!(link instanceof HTMLAnchorElement)) return;

        const currentPath = window.location.pathname;
        const targetPath = new URL(link.href, window.location.origin).pathname;

        if (!canRestoreProjectScroll(currentPath) || !isProjectDetailPath(targetPath)) return;

        sessionStorage.setItem(
          PROJECT_SCROLL_STATE_KEY,
          JSON.stringify({
            path: currentPath,
            scrollY: window.scrollY,
          }),
        );
      }

      function restoreProjectScrollPosition() {
        const rawState = sessionStorage.getItem(PROJECT_SCROLL_STATE_KEY);
        if (!rawState) return;

        try {
          const state = JSON.parse(rawState);
          if (state?.path !== window.location.pathname || typeof state?.scrollY !== "number") return;

          sessionStorage.removeItem(PROJECT_SCROLL_STATE_KEY);
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              window.scrollTo({ top: state.scrollY, behavior: "auto" });
            });
          });
        } catch {
          sessionStorage.removeItem(PROJECT_SCROLL_STATE_KEY);
        }
      }

      restoreProjectScrollPosition();

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest("a[href]");
        if (!(link instanceof HTMLAnchorElement)) return;

        saveProjectScrollPosition(link);
      });

      document.addEventListener("astro:after-swap", () => {
        restoreProjectScrollPosition();
      });
    </script>
    <Analytics />
    <SpeedInsights />
  </head>
    <body class="min-h-dvh flex flex-col bg-[var(--color-background)]">
      <a href="#main-content" class="skip-to-content">
        Przejdź do treści
      </a>
      <Header caseStudy={caseStudyHeader} workPage={workPage} homePage={homePage} aboutPage={aboutPage} />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      {showFooter && <Footer workPage={workPage} homePage={homePage} aboutPage={aboutPage} />}
    </body>
  </html>
