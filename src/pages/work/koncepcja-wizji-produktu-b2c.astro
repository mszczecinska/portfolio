---
import WorkCaseShell from "../../components/work/WorkCaseShell.astro";
import KoncepcjaCaseContent from "../../components/work/cases/KoncepcjaCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("koncepcja-wizji-produktu-b2c");

if (!project) {
  return Astro.redirect("/work");
}

const tools = [
  { src: "/icons/tool-figma.png", alt: "Figma" },
  { src: "/icons/tool-notion.png", alt: "Notion" },
  { src: "/icons/tool-openai.png", alt: "OpenAI" },
] as const;
---

<WorkCaseShell
  project={project}
  tools={tools}
  heroImage="/assets/inx/hero-inx.png"
  heroHasSurface={false}
  overviewHeading="Wstęp"
  overviewText="InsightX miał silny silnik analityczny i rozpoznawalne narzędzia B2B, ale potrzebował kierunku dla samodzielnego produktu B2C. Projekt polegał na przejściu od szerokich hipotez do konkretnej wizji produktu dla zaawansowanych traderów."
  duration="1 miesiąc"
  projectType="Komercyjny"
  impactItems={[
    {
      title: "Problem",
      text: "InsightX miał silny silnik B2B i miliony użytkowników przez integracje, ale brakowało mu rozpoznawalnego, samodzielnego kierunku B2C.",
    },
    {
      title: "Cel",
      text: "Zrozumieć użytkowników, znaleźć lukę na rynku i zaproponować kierunek produktowy możliwy do dalszego testowania.",
    },
    {
      title: "Efekt",
      text: "Powstała wizja InfoFi workspace, oparta na personach, JTBD, analizie konkurencji i hipotezach produktowych.",
    },
  ]}
>
  <KoncepcjaCaseContent />
</WorkCaseShell>
