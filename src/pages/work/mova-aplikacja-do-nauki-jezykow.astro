---
import WorkCaseShell from "../../components/work/WorkCaseShell.astro";
import MovaCaseContent from "../../components/work/cases/MovaCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("mova-aplikacja-do-nauki-jezykow");

if (!project) {
  return Astro.redirect("/work");
}

const tools = [{ src: "/icons/tool-figma.png", alt: "Figma" }] as const;
---

<WorkCaseShell
  project={project}
  tools={tools}
  heroImage="/assets/mova/hero-mova.png"
  overviewHeading="Kontekst projektu"
  overviewText="Mova to koncept aplikacji do nauki języków oparty na realnym projekcie komercyjnym. Skupiłam się na strukturze lekcji, czytelnym progresie i systemie UI, który wspiera naukę zamiast konkurować z treścią."
  duration="2 tygodnie"
  projectType="Konceptualny na bazie projektu komercyjnego"
  impactItems={[
    {
      title: "Problem",
      text: "Aplikacje do nauki języków często wpadają w nadmierną gamifikację albo przytłaczają użytkownika zbyt dużą ilością treści.",
    },
    {
      title: "Cel",
      text: "Zaprojektować spokojną, czytelną aplikację, która prowadzi przez naukę krok po kroku i jasno pokazuje progres.",
    },
    {
      title: "Efekt",
      text: "Powstał koncept aplikacji mobile i web z logiczną strukturą lekcji, ekranami feedbacku i skalowalnym UI Kitem.",
    },
  ]}
>
  <MovaCaseContent />
</WorkCaseShell>
