---
import WorkCaseShell from "../../components/work/WorkCaseShell.astro";
import ReadySetCaseContent from "../../components/work/cases/ReadySetCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("readyset-aplikacja-do-planowania-wyjazdow");

if (!project) {
  return Astro.redirect("/work");
}

const tools = [
  { src: "/icons/tool-figma.png", alt: "Figma" },
  { src: "/icons/tool-notion.png", alt: "Notion" },
  { src: "/icons/tool-openai.png", alt: "OpenAI" },
  { src: "/icons/tool-gemini.png", alt: "Gemini" },
] as const;
---

<WorkCaseShell
  project={project}
  tools={tools}
  heroImage="/assets/ready-set/hero-readyset.png"
  overviewHeading="Wstęp"
  overviewText="ReadySet porządkuje planowanie grupowych wyjazdów: zbiera linki, decyzje i komentarze w jednym miejscu, zamiast zostawiać je w czatach i arkuszach. Kluczową decyzją było rozdzielenie procesu na planowanie i gotowy harmonogram, żeby grupa mogła najpierw wybrać opcje, a później korzystać z jednego finalnego planu."
  duration="około 5 tygodni"
  projectType="Konceptualny"
  impactItems={[
    {
      title: "Problem",
      text: "Planowanie wyjazdów w grupie generuje chaos, bo informacje, decyzje i linki są rozproszone między czatami, mailami i arkuszami.",
    },
    {
      title: "Cel",
      text: "Zaprojektować aplikację, która zbiera propozycje, ułatwia wspólne decyzje i zamienia ustalenia w jeden czytelny harmonogram.",
    },
    {
      title: "Efekt",
      text: "Powstał koncept aplikacji mobilnej z kategoriami, opcjami, głosowaniem, komentarzami i generowanym harmonogramem wyjazdu.",
    },
  ]}
>
  <ReadySetCaseContent />
</WorkCaseShell>
