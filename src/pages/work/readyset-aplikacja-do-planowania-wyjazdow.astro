---
import CaseStudyShell from "../../components/work/CaseStudyShell.astro";
import CaseStudyIntro from "../../components/work/CaseStudyIntro.astro";
import CaseStudyPagination from "../../components/work/CaseStudyPagination.astro";
import ReadySetCaseContent from "../../components/work/cases/ReadySetCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("readyset-aplikacja-do-planowania-wyjazdow");
if (!project) return Astro.redirect("/work");
---

<CaseStudyShell title="ReadySet — wspólny wyjazd, jeden plan" description={project.description}>
  <CaseStudyIntro
    title="ReadySet"
    subtitle="Wspólny wyjazd. Jeden plan."
    overview="ReadySet to koncepcja aplikacji mobilnej do grupowego planowania wyjazdów. Łączy propozycje, głosowanie i ustalony harmonogram, pomagając uczestnikom wspólnie podejmować decyzje."
    role="UX/UI designer"
    projectType="Projekt koncepcyjny"
    tools={[
      { src: "/icons/tool-figma.png", alt: "Figma" },
      { src: "/icons/tool-notion.png", alt: "Notion" },
      { src: "/icons/tool-openai.png", alt: "OpenAI" },
    ]}
    facts={[
      { title: "Problem", text: "Pomysły i ustalenia dotyczące wyjazdu giną w rozmowach, a zebranie ich w jeden plan wymaga dodatkowej pracy." },
      { title: "Cel", text: "Zaprojektowanie miejsca, w którym grupa może zgłaszać propozycje, wybierać je i układać wspólny harmonogram." },
      { title: "Efekt", text: "Interaktywny prototyp aplikacji, sprawdzony w testach wybranych zadań." },
    ]}
  />
  <ReadySetCaseContent />
  <CaseStudyPagination
    previous={{ title: "InsightX", description: "Od hipotez do kierunku produktu B2C", href: "/work/koncepcja-wizji-produktu-b2c" }}
    next={{ title: "Mova", description: "Czytelna ścieżka nauki języków", href: "/work/mova-aplikacja-do-nauki-jezykow" }}
  />
</CaseStudyShell>
