---
import WorkCaseShell from "../../components/work/WorkCaseShell.astro";
import PortfolioCaseContent from "../../components/work/cases/PortfolioCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("szczecinska-design-portfolio");

if (!project) {
  return Astro.redirect("/work");
}

const tools = [
  { src: "/icons/tool-figma.png", alt: "Figma" },
  { src: "/icons/tool-claude-code.png", alt: "Claude Code" },
  { src: "/icons/tool-cursor.svg", alt: "Cursor" },
  { src: "/icons/tool-codex.png", alt: "Codex" },
  { src: "/icons/tool-vercel.svg", alt: "Vercel" },
] as const;
---

<WorkCaseShell
  project={project}
  tools={tools}
  heroImage="/assets/portfolio/hero-portfolio.png"
  overviewHeading="Wstęp"
  overviewText="Portfolio potraktowałam jak produkt: miało szybko pokazać sposób myślenia, projekty i poziom dopracowania, bez przeładowania treścią. Wybrałam minimalistyczny kierunek, prostą nawigację i kilka charakterystycznych detali, żeby strona była spokojna, ale nie anonimowa."
  primaryMetaLabel="Czas trwania"
  primaryMetaValue="3 tygodnie"
  projectType="Osobisty"
  toolsCompact={true}
  impactItems={[
    {
      title: "Problem",
      text: "Portfolio miało pokazać dużo projektów, materiałów i decyzji bez przytłaczania odbiorcy.",
    },
    {
      title: "Cel",
      text: "Zaprojektować i wdrożyć minimalistyczną stronę z jasnym przekazem, prostą nawigacją i detalami pokazującymi moje podejście do designu.",
    },
    {
      title: "Efekt",
      text: "Wdrożone portfolio z płynnymi przejściami, dopracowanym responsive designem i wynikami Lighthouse 100/100 w każdej kategorii.",
    },
  ]}
>
  <PortfolioCaseContent />
</WorkCaseShell>
