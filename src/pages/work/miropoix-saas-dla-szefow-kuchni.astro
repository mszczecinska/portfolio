---
import WorkCaseShell from "../../components/work/WorkCaseShell.astro";
import MiropoixCaseContent from "../../components/work/cases/MiropoixCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("miropoix-saas-dla-szefow-kuchni");

if (!project) {
  return Astro.redirect("/work");
}

const tools = [
  { src: "/icons/tool-figma.png", alt: "Figma" },
  { src: "/icons/tool-jitter.png", alt: "Jitter" },
  { src: "/icons/tool-cursor.svg", alt: "Cursor" },
  { src: "/icons/tool-claude-code.png", alt: "Claude Code" },
  { src: "/icons/tool-vercel.svg", alt: "Vercel" },
] as const;
---

<WorkCaseShell
  project={project}
  tools={tools}
  heroImage="/assets/miropoix/hero-miropoix.png"
  overviewHeading="Wstęp"
  overviewText="Miropoix to aplikacja SaaS skierowana do zespołów kuchennych. Aplikacja daje zespołowi jedno wspólne narzędzie, w którym każdy kucharz dodaje to, co potrzebuje danego dnia. Lista jest automatycznie segregowana według dostawców, a szef kuchni akceptuje zamówienie i może je wysłać bezpośrednio do hurtowni przez e-mail lub WhatsApp."
  primaryMetaLabel="Rola"
  primaryMetaValue="Product Engineer"
  projectType="Komercyjny"
  toolsCompact={true}
  impactItems={[
    {
      title: "Problem",
      text: "Aplikacja rozwiązywała realny problem zamówień w kuchni, ale wizualnie była generyczna i nie budowała rozpoznawalnego charakteru marki.",
    },
    {
      title: "Cel",
      text: "Odświeżyć UI, zaprojektować landing page i nadać produktowi wyrazisty kierunek wizualny związany z branżą gastronomiczną.",
    },
    {
      title: "Efekt",
      text: "Powstały nowe widoki aplikacji, animacje, landing page i wdrożona strona internetowa dla Miropoix.",
    },
  ]}
>
  <MiropoixCaseContent liveUrl={project.links?.live} />
</WorkCaseShell>
