---
import WorkCaseShell from "../../components/work/WorkCaseShell.astro";
import AurapuraCaseContent from "../../components/work/cases/AurapuraCaseContent.astro";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("aurapura-design-system");

if (!project) {
  return Astro.redirect("/work");
}

const tools = [
  { src: "/icons/tool-figma.png", alt: "Figma" },
] as const;
---

<WorkCaseShell
  project={project}
  tools={tools}
  heroImage="/assets/aurapura/hero-aurapure.png"
  heroHasSurface={true}
  overviewHeading="Wstęp"
  overviewText={project.description}
  duration="około 6 tygodni"
  projectType="Konceptualny (kurs Design system intro)"
  impactItems={[
    {
      title: "Problem",
      text: "Brief marki i assety wymagały przełożenia na spójny system, który działa na różnych wielkościach ekranu.",
    },
    {
      title: "Cel",
      text: "Przejść przez pełny proces budowy design systemu: od tokenów i komponentów po finalne layouty.",
    },
    {
      title: "Efekt",
      text: "Powstał system oparty o core i alias tokeny, Figma variables, komponenty oraz widoki mobile, tablet i desktop.",
    },
  ]}
>
  <AurapuraCaseContent />
</WorkCaseShell>
