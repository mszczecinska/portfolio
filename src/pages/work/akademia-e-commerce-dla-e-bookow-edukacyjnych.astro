---
import CaseStudyShell from "../../components/work/CaseStudyShell.astro";
import CaseStudyIntro from "../../components/work/CaseStudyIntro.astro";
import CaseStudyPagination from "../../components/work/CaseStudyPagination.astro";
import AkademiaCaseContent from "../../components/work/cases/AkademiaCaseContent.astro";
import { getProjectCover } from "../../lib/projectCovers";
import { getProjectBySlug } from "../../lib/projects";

const project = getProjectBySlug("akademia-e-commerce-dla-e-bookow-edukacyjnych");
if (!project) return Astro.redirect("/work");
---

<CaseStudyShell title="Akademia — e-commerce dla e-booków edukacyjnych" description={project.description}>
  <CaseStudyIntro
    cover={getProjectCover("akademia-e-commerce-dla-e-bookow-edukacyjnych")}
    title="Akademia"
    subtitle="e-commerce dla e-booków edukacyjnych"
    tools={[{ src: "/icons/tool-figma.png", alt: "Figma" }]}
    overview="Akademia to sklep z e-bookami edukacyjnymi zaprojektowany jako subaplikacja strony Studio Nauczania Justyna Magiera. Projekt miał przenieść charakter marki do bardziej przejrzystego i nowoczesnego interfejsu, który lepiej odpowiada potrzebom sklepu internetowego."
    role="UX/UI designer"
    projectType="Projekt komercyjny"
    liveUrl={project.links?.live}
    showLiveInfo
    liveHoverColor="#F5EDE5"
    facts={[
      { title: "Problem", text: "Stworzenie projektu sklepu internetowego, który będzie naturalnym przedłużeniem istniejącej marki." },
      { title: "Cel", text: "Zaprojektowanie spójnej ścieżki od znalezienia e-booka do korzystania z zakupionych materiałów oraz odświeżenie warstwy UI." },
      { title: "Efekt", text: "Pełna makieta w Figmie, gotowa do dalszych prac developerskich." },
    ]}
  />
  <AkademiaCaseContent />
  <CaseStudyPagination slug="akademia-e-commerce-dla-e-bookow-edukacyjnych" />
</CaseStudyShell>
