---
import Layout from "../layouts/Layout.astro";
import { contactMailto } from "../lib/contact";
import { Picture } from "astro:assets";
import { getProjectCover } from "../lib/projectCovers";

const featuredProjects = [
  {
    slug: "akademia-e-commerce-dla-e-bookow-edukacyjnych",
    title: "Akademia",
    cover: getProjectCover("akademia-e-commerce-dla-e-bookow-edukacyjnych"),
    badges: "UX/UI / E-COMMERCE / EDUTECH",
    description: "Od marki edukacyjnej do sklepu z e-bookami. Projekt UX/UI obejmujący pełną ścieżkę zakupową na desktopie i mobile.",
  },
  {
    slug: "miropoix-saas-dla-szefow-kuchni",
    title: "Miropoix",
    badges: "UI / DEVELOPMENT / SAAS",
    description: "Nowa strona aplikacji dla zespołów kuchennych. Redesign landing page, motion i wdrożenie przy wsparciu narzędzi AI.",
  },
];
const services = [
  { title: "UX/UI design", text: "Porządkuję strukturę produktu, ścieżki użytkownika i interfejsy aplikacji." },
  { title: "Strony internetowe", text: "Przekładam charakter marki i jej ofertę na czytelną stronę." },
  { title: "E-commerce", text: "Układam ścieżkę od poznania produktu do zakupu i dostępu do zamówienia." },
  { title: "Motion", text: "Tworzę animacje interfejsów i materiałów prezentujących produkt." },
  { title: "Wdrożenia z AI", text: "Zamieniam projekty stron w działające rozwiązania przy wsparciu narzędzi AI." },
];
---

<Layout title="Główna" description="Magda Szczecińska — projektantka UX/UI. Projektuję strony i aplikacje, od koncepcji po wdrożenie." homePage>
  <div class="home-page">
    <section class="home-hero page-container" aria-labelledby="home-title">
      <div class="home-hero__heading">
        <h1 id="home-title" class="type-display">Magda<br />Szczecińska</h1>
        <p class="home-hero__role type-label">UX/UI designer</p>
      </div>
      <div class="home-hero__intro">
        <div class="home-hero__portrait media-placeholder" aria-hidden="true"></div>
        <p>Projektuję strony i aplikacje, łącząc potrzeby użytkowników z dopracowanym UI. Wybrane projekty rozwijam od koncepcji po wdrożenie, korzystając z narzędzi AI.</p>
        <div class="home-hero__actions">
          <a href="/work" class="btn-primary home-primary-button">Zobacz moje prace <span class="home-primary-arrow" aria-hidden="true"><img class="home-button-arrow" src="/assets/home/arrow-down-left.svg" width="24" height="24" alt="" /><img class="home-button-arrow home-primary-arrow--hover" src="/assets/home/arrow-down-left-hover.svg" width="24" height="24" alt="" /></span></a>
          <a href="/about" class="btn-secondary">O mnie <img class="home-button-arrow" src="/assets/home/arrow-down-left.svg" width="24" height="24" alt="" /></a>
        </div>
      </div>
    </section>

    <section class="home-featured" aria-labelledby="home-featured-title">
      <h2 id="home-featured-title" class="sr-only">Wybrane projekty</h2>
      <div class="home-featured__list">
        {featuredProjects.map(project => (
          <article class="home-project">
            <a href={`/work/${project.slug}`} class="home-project__link page-container" aria-labelledby={`home-${project.slug}`}>
              <div class="home-project__heading">
                <p class="home-project__badges type-label">{project.badges}</p>
                <h3 id={`home-${project.slug}`}>{project.title}</h3>
                <span class="home-project__arrow" aria-hidden="true"><img src="/assets/work/arrow-down-left.svg" width="46" height="46" alt="" /></span>
              </div>
              <div class:list={["home-project__media", { "media-placeholder": !project.cover }]} aria-hidden="true">
                {project.cover && <Picture
                  src={project.cover}
                  alt=""
                  formats={["avif", "webp"]}
                  widths={[480, 800, 1200, 1600, 2400]}
                  sizes="(min-width: 1280px) 588px, (min-width: 1024px) calc(50vw - 52px), calc(100vw - 40px)"
                  quality={85}
                  loading="lazy"
                />}
              </div>
              <p class="home-project__description">{project.description}</p>
            </a>
          </article>
        ))}
      </div>
      <div class="home-featured__more page-container">
        <a href="/work" class="btn-primary home-primary-button">Zobacz wszystkie projekty <span class="home-primary-arrow" aria-hidden="true"><img class="home-button-arrow" src="/assets/home/arrow-down-left.svg" width="24" height="24" alt="" /><img class="home-button-arrow home-primary-arrow--hover" src="/assets/home/arrow-down-left-hover.svg" width="24" height="24" alt="" /></span></a>
      </div>
    </section>

    <section class="home-services page-container" aria-labelledby="home-services-title">
      <h2 id="home-services-title">Czym się zajmuję</h2>
      <dl class="home-services__list">
        {services.map(service => (
          <div class="home-services__row">
            <dt class="type-label">{service.title}</dt>
            <dd>{service.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="home-contact page-container" aria-labelledby="home-contact-title">
      <div class="home-contact__content">
        <h2 id="home-contact-title">Masz projekt do zaprojektowania albo szukasz projektantki do zespołu?</h2>
        <a href={contactMailto} class="btn-primary home-primary-button">Porozmawiajmy <span class="home-primary-arrow" aria-hidden="true"><img class="home-button-arrow" src="/assets/home/arrow-down-left.svg" width="24" height="24" alt="" /><img class="home-button-arrow home-primary-arrow--hover" src="/assets/home/arrow-down-left-hover.svg" width="24" height="24" alt="" /></span></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-page { padding-top: var(--space-10); padding-bottom: var(--space-10); }
  .home-hero { display: grid; gap: var(--space-10); margin-bottom: var(--space-10); }
  .home-hero__heading { min-width: 0; }
  .home-hero h1 { letter-spacing: 0; text-wrap: initial; }
  .home-hero__role { margin-top: var(--space-5); font-size: var(--text-body); color: var(--color-text-muted); }
  .home-hero__intro { display: grid; gap: var(--space-5); justify-self: end; width: min(100%, 320px); }
  .home-hero__portrait { --media-ratio: 229 / 172; }
  .home-hero__intro > p { font-size: var(--text-small); line-height: 1.5; }
  .home-hero__actions { display: flex; align-items: flex-start; gap: var(--space-5); }
  .home-hero__actions a { white-space: nowrap; }
  .home-button-arrow { flex-shrink: 0; transform: rotate(180deg); }
  .home-primary-arrow { display: grid; flex-shrink: 0; }
  .home-primary-arrow img { grid-area: 1 / 1; transition: opacity var(--duration-ui) var(--ease-ui); }
  .home-primary-arrow--hover { opacity: 0; }
  .home-primary-button:focus-visible { background: var(--color-text); color: var(--color-surface); }
  .home-primary-button:focus-visible .home-primary-arrow img:first-child { opacity: 0; }
  .home-primary-button:focus-visible .home-primary-arrow--hover { opacity: 1; }
  .home-project { border-top: var(--border-width) solid var(--color-border); }
  .home-project:last-child { border-bottom: var(--border-width) solid var(--color-border); }
  .home-project__link { display: grid; grid-template-rows: auto minmax(180px, 1fr) auto; gap: 18px; min-height: 425px; padding: var(--space-5); color: inherit; text-decoration: none; }
  .home-project__heading { display: grid; grid-template-columns: minmax(0, 1fr) 70px; grid-template-rows: auto auto; gap: 10px; align-content: start; }
  .home-project__badges { grid-column: 1; line-height: 18px; }
  .home-project h3 { grid-column: 1; font-size: 24px; line-height: 38px; font-weight: var(--weight-regular); }
  .home-project__arrow { grid-column: 2; grid-row: 1 / 3; display: grid; place-items: center; width: 70px; height: 70px; padding: var(--space-3); }
  .home-project__arrow img { transform: rotate(180deg); transition: transform var(--duration-ui) var(--ease-ui); }
  .home-project__media { position: relative; aspect-ratio: auto; overflow: hidden; }
  .home-project__media :global(picture) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .home-project__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .home-project__description { font-size: var(--text-small); line-height: 25px; }
  .home-featured__more { display: none; }
  .home-services { display: grid; gap: var(--space-5); margin-top: var(--space-10); }
  .home-services h2 { font-size: 24px; font-weight: var(--weight-medium); line-height: 1.3; }
  .home-services__list { margin: 0; }
  .home-services__row { display: grid; grid-template-columns: minmax(0, 156fr) minmax(0, 181fr); gap: var(--space-6); align-items: center; padding-block: var(--space-3); border-bottom: var(--border-width) solid var(--color-border); }
  .home-services__row:first-child { padding-top: 0; }
  .home-services__row:last-child { padding-bottom: 0; border-bottom: 0; }
  .home-services dd { min-width: 0; margin: 0; font-size: var(--text-small); line-height: 25px; }
  .home-contact { margin-top: var(--space-10); }
  .home-contact__content { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-5); }
  .home-contact h2 { width: 100%; font-size: 24px; line-height: 1.3; font-weight: var(--weight-regular); }
  @media (hover: hover) {
    .home-primary-button:hover { background: var(--color-text); color: var(--color-surface); }
    .home-primary-button:hover .home-primary-arrow img:first-child { opacity: 0; }
    .home-primary-button:hover .home-primary-arrow--hover { opacity: 1; }
    .home-project__link:hover .home-project__arrow img { transform: translate(2px, -2px) rotate(180deg); }
  }
  @media (max-width: 63.999rem) {
    .home-page { --section-gap: var(--space-20); padding-bottom: var(--section-gap); }
    .home-hero { margin-bottom: var(--section-gap); }
    .home-services, .home-contact { margin-top: var(--section-gap); }
    .home-services { gap: var(--space-8); }
    .home-contact__content { gap: var(--space-8); }
  }
  @media (max-width: 22.5rem) {
    .home-hero__actions { gap: var(--space-2); }
    .home-hero__actions a { padding-inline: var(--space-3); }
    .home-project__heading { grid-template-columns: minmax(0, 1fr) 46px; }
    .home-project__arrow { width: 46px; height: 46px; padding: 0; }
  }
  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .home-hero__intro { width: 55%; }
  }
  @media (min-width: 64rem) {
    .home-page { padding-top: 43px; padding-bottom: var(--space-30); }
    .home-hero { grid-template-columns: minmax(0, 764fr) minmax(0, 412fr); align-items: start; gap: var(--space-10); margin-bottom: var(--space-30); }
    .home-hero__heading { padding-top: 53px; }
    .home-hero h1 { font-size: clamp(96px, 10vw, 128px); }
    .home-hero__role { margin-top: var(--space-8); padding-left: var(--space-2); font-size: 20px; line-height: 18px; color: var(--color-text); }
    .home-hero__intro { width: 100%; gap: var(--space-6); }
    .home-hero__portrait { --media-ratio: 412 / 309; margin-bottom: var(--space-2); }
    .home-hero__intro > p { font-size: var(--text-body); }
    .home-hero__actions { gap: var(--space-5); }
    .home-project__link { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: var(--space-10); row-gap: var(--space-6); padding: var(--space-10) var(--page-gutter); min-height: 468px; }
    .home-project__heading { grid-column: 2; grid-row: 1; row-gap: var(--space-10); }
    .home-project__badges { font-size: var(--text-body); }
    .home-project h3 { font-size: 64px; line-height: 1.15; }
    .home-project__arrow { align-self: center; }
    .home-project__media { grid-column: 1; grid-row: 1 / 3; min-height: 388px; }
    .home-project__description { grid-column: 2; align-self: end; font-size: var(--text-body); }
    .home-featured__more { display: flex; justify-content: center; margin-top: var(--space-10); }
    .home-services { grid-template-columns: minmax(0, 309fr) minmax(0, 821fr); gap: var(--space-20); margin-top: var(--space-16); }
    .home-services h2 { font-size: 40px; }
    .home-services__row { grid-template-columns: minmax(0, 262fr) minmax(0, 535fr); }
    .home-services dd { font-size: var(--text-body); }
    .home-contact { margin-top: var(--space-30); }
    .home-contact__content { max-width: 700px; margin-left: auto; align-items: flex-start; gap: var(--space-8); }
    .home-contact h2 { font-size: 40px; }
  }
  @media (min-width: 64rem) and (max-width: 75rem) {
    .home-hero { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
    .home-hero__actions { flex-wrap: wrap; gap: var(--space-2); }
    .home-services { gap: var(--space-10); }
    .home-services h2 { font-size: 32px; }
  }
</style>
