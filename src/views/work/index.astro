---
import Layout from "../../layouts/Layout.astro";
import { Picture } from "astro:assets";
import { getProjectCover } from "../../lib/projectCovers";
import { wideImageSize } from "../../lib/responsiveImages";

import { projectCards, experimentCards } from "../../lib/work";
import { experimentsPath, languageFromPath, languagePath, workPath } from "../../i18n/routes";

const language = languageFromPath(Astro.url.pathname);
const groups = [
  { id: "projects", path: workPath, label: "Projekty", cards: projectCards },
  { id: "experiments", path: experimentsPath, label: "Eksperymenty", cards: experimentCards },
];
const isExperiments = languagePath(Astro.url.pathname, "pl") === experimentsPath;
const group = isExperiments ? groups[1] : groups[0];
const title = isExperiments ? "Eksperymenty" : "Work";
const description = isExperiments
  ? "Eksperymenty Magdy Szczecińskiej z identyfikacją wizualną i projektowaniem stron."
  : "Projekty UX/UI, design systemy i eksperymenty Magdaleny Szczecińskiej.";
---

<Layout title={title} description={description} workPage>
  <h1 class="sr-only">{isExperiments ? "Eksperymenty" : "Realizacje i eksperymenty"}</h1>
  <div class="work-page" data-work-page>
    <nav class="work-categories page-container" aria-label="Kategorie realizacji">
      {groups.map((item) => (
        <a
          href={languagePath(item.path, language)}
          class="work-category"
          aria-current={item.id === group.id ? "page" : undefined}
          data-work-category={item.id}
        >
          <span class="entry-mask"><span data-entry-reveal>{item.label} ({String(item.cards.length).padStart(2, "0")})</span></span>
        </a>
      ))}
    </nav>

    <section
      id={`work-${group.id}`}
      class:list={["work-grid", { "work-grid--experiments": group.id === "experiments" }]}
      data-work-group={group.id}
      aria-label={group.label}
    >
      {group.cards.map((card, index) => {
        const cover = getProjectCover(card.slug);
        const href = languagePath(`/${card.slug}`, language);
        return (
          <article class:list={["work-card", { "work-card--featured": group.id === "projects" && index < 2 }]}>
            <a
              href={href}
              class="work-card__link"
              aria-labelledby={`title-${card.slug}`}
            >
              <div class="work-card__heading">
                <p class="work-card__badges type-label">{card.badges}</p>
                <h2 id={`title-${card.slug}`}>{card.title}</h2>
                <span class="work-card__arrow" aria-hidden="true">
                  <img src="/assets/work/arrow-down-left.svg" width="46" height="46" alt="" />
                </span>
              </div>
              <div class:list={["work-card__media", { "media-placeholder": !cover }]} aria-hidden="true" data-project-cover={cover ? card.slug : undefined}>
                {cover && <Picture
                  src={cover}
                  alt=""
                  formats={["avif", "webp"]}
                  widths={[480, 800, 1200, 1600, 2400]}
                  sizes={group.id === "experiments"
                    ? `${wideImageSize(30.375)}, (min-width: 1280px) 486px, (min-width: 1024px) calc(40.635vw - 34.134px), calc(100vw - 40px)`
                    : index < 2
                      ? `${wideImageSize(35.5)}, (min-width: 1280px) 568px, (min-width: 1024px) calc(50vw - 72px), calc(100vw - 40px)`
                      : `auto, ${wideImageSize(16.875)}, (min-width: 1280px) 270px, (min-width: 1024px) calc(25vw - 46px), calc(100vw - 40px)`}
                  quality={85}
                  loading={index === 0 ? "eager" : "lazy"}
                />}
              </div>
              <p class="work-card__description">{card.description}</p>
            </a>
          </article>
        );
      })}
    </section>
  </div>
</Layout>

<style>
  .work-page { padding-block: var(--space-10); }
  .work-categories { display: flex; align-items: baseline; gap: var(--space-5); margin-bottom: var(--space-10); }
  .work-category { color: var(--color-text-muted); font-size: 20px; line-height: normal; text-decoration: none; white-space: nowrap; }
  .work-category[aria-current] { color: var(--color-text); font-size: 24px; font-weight: var(--weight-regular); }
  .work-grid { border-top: 1px solid var(--color-border); padding-top: 8px; }
  .work-card { position: relative; isolation: isolate; min-width: 0; padding: 20px; border-bottom: 1px solid var(--color-border); }
  .work-card::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: var(--color-surface); opacity: 0; transition: opacity 240ms var(--ease-editorial); }
  .work-card + .work-card { margin-top: 8px; }
  .work-card__link { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: 18px; min-height: 385px; color: inherit; text-decoration: none; }
  .work-card__heading { display: grid; grid-template-columns: minmax(0, 1fr) 4.375rem; grid-template-rows: auto auto; gap: 0.625rem; align-content: start; }
  .work-card__badges { grid-column: 1; font-size: var(--text-label); line-height: var(--leading-label); }
  .work-card h2 { grid-column: 1; font-size: 1.5rem; line-height: 2.375rem; font-weight: var(--weight-regular); overflow-wrap: normal; }
  .work-card__arrow { grid-column: 2; grid-row: 1 / 3; display: grid; place-items: center; width: 4.375rem; height: 4.375rem; padding: var(--space-3); }
  .work-card__arrow img { width: 2.875rem; height: auto; transform: rotate(180deg); transition: transform var(--duration-ui) var(--ease-ui); }
  .work-card__media { position: relative; aspect-ratio: auto; min-height: 180px; }
  .work-card__media :global(picture) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .work-card__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .work-card__description { font-size: var(--text-small); line-height: 1.5625rem; }
  @media (hover: hover) and (pointer: fine) {
    .work-category:hover { color: var(--color-text); }
    .work-card__link:hover .work-card__arrow img { transform: translate(4px, -4px) rotate(180deg); }
  }
  @media (hover: hover) and (pointer: fine) {
    .work-card:has(.work-card__link:hover)::before { opacity: .55; }
  }
  .work-card:has(.work-card__link:focus-visible)::before { opacity: .55; }
  .work-card__link:focus-visible .work-card__arrow img { transform: translate(4px, -4px) rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    .work-card::before { transition: none; }
  }
  @media (max-width: 47.999rem) {
    .work-page { padding-bottom: var(--section-gap); }
    .work-categories { margin-bottom: var(--space-10); }
  }
  @media (max-width: 63.999rem) {
    .work-card::before { top: -8px; }
  }
  @media (max-width: 22.5rem) {
    .work-categories { gap: 12px; }
    .work-category { font-size: 17px; }
    .work-category[aria-current] { font-size: 20px; }
  }
  @media (min-width: 64rem) {
    .work-categories { gap: var(--space-10); }
    .work-category { font-size: 1.5rem; }
    .work-category[aria-current] { font-size: 2rem; }
    .work-grid {
      --work-gutter: max(var(--page-gutter), calc((100vw - var(--container-width)) / 2 + var(--page-gutter)));
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 0 var(--work-gutter);
      position: relative;
    }
    .work-grid::after { content: ""; position: absolute; width: 1px; top: 0; bottom: 0; left: 50%; background: var(--color-border); pointer-events: none; }
    .work-card { position: relative; padding: var(--space-10); }
    .work-card:nth-child(odd)::before { left: calc(-1 * var(--work-gutter)); }
    .work-card:nth-child(even)::before { right: calc(-1 * var(--work-gutter)); }
    .work-grid:not(.work-grid--experiments) .work-card:nth-child(odd) { padding-left: 0; }
    .work-grid:not(.work-grid--experiments) .work-card:nth-child(even) { padding-right: 0; }
    .work-card + .work-card { margin-top: 0; }
    .work-card::after { content: ""; position: absolute; bottom: -1px; height: 1px; width: var(--work-gutter); background: var(--color-border); }
    .work-card:nth-child(odd)::after { right: 100%; }
    .work-card:nth-child(even)::after { left: 100%; }
    .work-card__link { grid-template-columns: minmax(0, 250fr) minmax(0, 258fr); grid-template-rows: auto 1fr; gap: var(--space-5); min-height: 15.625rem; }
    .work-card__heading { grid-column: 2; grid-row: 1; column-gap: var(--space-3); }
    .work-card h2 { grid-column: 1; grid-row: 2; font-size: 2rem; }
    .work-card__arrow { grid-row: 2; }
    .work-card__badges { grid-column: 1 / -1; }
    .work-card__media { grid-column: 1; grid-row: 1 / 3; min-height: 15.625rem; }
    .work-card__description { grid-column: 2; align-self: end; font-size: var(--text-body); }
    .work-card--featured .work-card__link { display: flex; flex-direction: column; }
    .work-card--featured .work-card__badges { grid-column: 1; }
    .work-card--featured .work-card__arrow { grid-row: 1 / 3; }
    .work-card--featured .work-card__media { height: 24.25rem; min-height: 24.25rem; }
    #work-projects .work-card:not(.work-card--featured) .work-card__heading { grid-template-columns: minmax(0, 1fr); }
    #work-projects .work-card:not(.work-card--featured) .work-card__arrow { display: none; }
    .work-grid--experiments { grid-template-columns: minmax(0, 1fr); border-bottom: 1px solid var(--color-border); }
    .work-grid--experiments::after { display: none; }
    .work-grid--experiments .work-card { padding-inline: 0; border-bottom: 0; }
    .work-grid--experiments .work-card::after { display: none; }
    .work-grid--experiments .work-card::before { inset-inline: calc(-1 * var(--work-gutter)); }
    .work-grid--experiments .work-card__link { grid-template-columns: minmax(0, 486fr) minmax(0, 710fr); }
  }
  @media (min-width: 64rem) and (max-width: 74.999rem) {
    #work-projects .work-card:not(.work-card--featured) h2 { font-size: 28px; }
  }
</style>

<script>
  import { experimentsPath, languageFromPath, languagePath, workPath } from "../../i18n/routes";

  // Preserve links to the previous filter on static previews and other hosts.
  function redirectLegacyCategory() {
    const url = new URL(window.location.href);
    const path = languagePath(url.pathname, "pl");
    if (path !== workPath && path !== experimentsPath) return;
    if (url.searchParams.get("category") !== "experiments") return;

    url.searchParams.delete("category");
    if (path === experimentsPath) {
      history.replaceState(history.state, "", url);
    } else {
      url.pathname = languagePath(experimentsPath, languageFromPath(url.pathname));
      window.location.replace(url);
    }
  }

  redirectLegacyCategory();
  document.addEventListener("astro:page-load", redirectLegacyCategory);
</script>
